# Copy to .env (git-ignored) and fill in from the Supabase dashboard.
# Hosted project ref: bpxlnucpdmunyvwjpjov

# ── apps/api ────────────────────────────────────────────────────────────
# Postgres as the RLS-constrained application role. The login role must be
# GRANTed coresearch_app (00000000000002_rls.sql); every request does
# SET LOCAL ROLE coresearch_app + SET LOCAL app.current_user_id (ADR 0013).
CORESEARCH_APP_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Postgres as a BYPASSRLS role — projector, migrations, system work only.
# Never used to serve a user request.
CORESEARCH_SERVICE_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Supabase project URL, e.g. https://<ref>.supabase.co
# The API derives the expected JWT issuer as <SUPABASE_URL>/auth/v1.
SUPABASE_URL=https://<ref>.supabase.co

# Dashboard → Settings → API → JWT Secret. Used to verify the HS256
# signature on every access token. Treat as a credential: anyone holding
# it can mint a token for any user.
SUPABASE_JWT_SECRET=<jwt-secret>

# Origin allowed to call the API cross-origin (the SPA). Defaults to the
# Vite dev server.
WEB_ORIGIN=http://localhost:5173
PORT=8787

# ── apps/web ────────────────────────────────────────────────────────────
# The anon key is public by design — it is safe in the browser bundle
# because every table has RLS and the browser never touches the domain
# tables directly (docs/spec/02-api-contract.md §0).
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_API_URL=http://localhost:8787

# ── apps/worker (DeepSeek) ──────────────────────────────────────────────
# platform.deepseek.com → API keys. Worker reads this via --env-file=.env.
DEEPSEEK_API_KEY=
# Official OpenAI-compatible endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Latest flagship. Alternative: deepseek-flash
DEEPSEEK_MODEL=deepseek-v4-pro
